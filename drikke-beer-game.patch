diff --git a/src/features/games/domain/__tests__/beerGlass.test.ts b/src/features/games/domain/__tests__/beerGlass.test.ts
new file mode 100644
index 0000000..f0b4bb9
--- /dev/null
+++ b/src/features/games/domain/__tests__/beerGlass.test.ts
@@ -0,0 +1,88 @@
+import {
+    createFullBeer,
+    FULL_FILL,
+    isBeerEmpty,
+    MAX_FOAM,
+    MAX_POUR_PER_SECOND,
+    pourAngleFromGravity,
+    pourRate,
+    shakeFromSample,
+    smoothGravity,
+    spillAngleDeg,
+    stepBeer,
+} from "../beerGlass"
+
+const ASPECT = 1.8
+const STILL = { pourAngleDeg: 0, shakeG: 0 }
+
+describe("beerGlass", () => {
+    test("pourAngleFromGravity is 0 upright, positive turned clockwise and ±180 upside down", () => {
+        expect(pourAngleFromGravity({ x: 0, y: -1, z: 0 })).toBeCloseTo(0, 5)
+        expect(pourAngleFromGravity({ x: 1, y: 0, z: 0 })).toBeCloseTo(90, 5)
+        expect(pourAngleFromGravity({ x: -1, y: 0, z: 0 })).toBeCloseTo(-90, 5)
+        expect(Math.abs(pourAngleFromGravity({ x: 0, y: 1, z: 0 }) ?? 0)).toBeCloseTo(180, 5)
+    })
+
+    test("pourAngleFromGravity gives up when the phone lies flat or the sample is empty", () => {
+        expect(pourAngleFromGravity({ x: 0.05, y: -0.05, z: -1 })).toBeNull()
+        expect(pourAngleFromGravity({ x: 0, y: 0, z: 0 })).toBeNull()
+    })
+
+    test("smoothGravity returns the first sample and low-pass filters later ones", () => {
+        const first = { x: 0, y: -1, z: 0 }
+        expect(smoothGravity(null, first)).toEqual(first)
+        const next = smoothGravity(first, { x: 1, y: -1, z: 0 }, 0.5)
+        expect(next.x).toBeCloseTo(0.5, 5)
+        expect(next.y).toBeCloseTo(-1, 5)
+    })
+
+    test("shakeFromSample measures distance from resting gravity", () => {
+        expect(shakeFromSample({ x: 0, y: -1, z: 0 })).toBeCloseTo(0, 5)
+        expect(shakeFromSample({ x: 0, y: -2, z: 0 })).toBeCloseTo(1, 5)
+    })
+
+    test("spillAngleDeg shrinks as the glass fills and is 0 when brim-full", () => {
+        expect(spillAngleDeg(1, ASPECT)).toBeCloseTo(0, 5)
+        expect(spillAngleDeg(0.9, ASPECT)).toBeLessThan(spillAngleDeg(0.5, ASPECT))
+        expect(spillAngleDeg(0, ASPECT)).toBeLessThan(90)
+    })
+
+    test("pourRate is zero below the rim angle and capped when tipped far over", () => {
+        const spill = spillAngleDeg(FULL_FILL, ASPECT)
+        expect(pourRate(FULL_FILL, ASPECT, spill - 1)).toBe(0)
+        expect(pourRate(FULL_FILL, ASPECT, -(spill + 5))).toBeGreaterThan(0)
+        expect(pourRate(FULL_FILL, ASPECT, 180)).toBe(MAX_POUR_PER_SECOND)
+        expect(pourRate(FULL_FILL, ASPECT, null)).toBe(0)
+    })
+
+    test("an upright glass keeps its beer while the foam settles", () => {
+        const start = createFullBeer()
+        const next = stepBeer(start, STILL, 0.1, ASPECT)
+        expect(next.fill).toBe(start.fill)
+        expect(next.foam).toBeLessThan(start.foam)
+        expect(next.isPouring).toBe(false)
+    })
+
+    test("tipping the glass upside down empties it and clears the foam", () => {
+        let state = createFullBeer()
+        for (let i = 0; i < 100 && !isBeerEmpty(state); i++) {
+            state = stepBeer(state, { pourAngleDeg: 180, shakeG: 0 }, 0.1, ASPECT)
+        }
+        expect(isBeerEmpty(state)).toBe(true)
+        expect(state).toEqual({ fill: 0, foam: 0, isPouring: false })
+    })
+
+    test("pouring reports isPouring and clamps long frame gaps", () => {
+        const next = stepBeer(createFullBeer(), { pourAngleDeg: 180, shakeG: 0 }, 5, ASPECT)
+        expect(next.isPouring).toBe(true)
+        expect(next.fill).toBeCloseTo(FULL_FILL - MAX_POUR_PER_SECOND * 0.1, 5)
+    })
+
+    test("shaking builds foam up to the cap and never past the room above the beer", () => {
+        let state = createFullBeer()
+        for (let i = 0; i < 200; i++) {
+            state = stepBeer(state, { pourAngleDeg: 0, shakeG: 3 }, 0.1, ASPECT)
+        }
+        expect(state.foam).toBeCloseTo(Math.min(MAX_FOAM, 1 - FULL_FILL), 5)
+    })
+})
diff --git a/src/features/games/domain/beerGlass.ts b/src/features/games/domain/beerGlass.ts
new file mode 100644
index 0000000..b0aa13b
--- /dev/null
+++ b/src/features/games/domain/beerGlass.ts
@@ -0,0 +1,128 @@
+// Pure maths for the virtual beer ("Drikke"), in the spirit of iBeer. The
+// screen is the glass: the beer surface stays level with the ground while the
+// phone turns, and tipping the glass past the rim angle pours the beer out.
+// Accelerometer samples follow the expo-sensors convention used by the spirit
+// level: x to the right edge, y to the top edge, upright portrait is y = -1.
+
+import type { GravitySample } from "@/features/games/domain/spiritLevel"
+
+export interface BeerState {
+    // Share of the glass height filled with beer, in [0, 1].
+    fill: number
+    // Foam head thickness as a share of the glass height, in [0, MAX_FOAM].
+    foam: number
+    isPouring: boolean
+}
+
+export interface BeerInput {
+    // In-plane rotation of the glass from upright; null when the phone lies
+    // too flat for the direction of "down" on screen to be meaningful.
+    pourAngleDeg: number | null
+    // How hard the phone is being shaken, in g beyond the resting 1 g.
+    shakeG: number
+}
+
+export const FULL_FILL = 0.82
+export const FRESH_FOAM = 0.1
+export const MAX_FOAM = 0.22
+export const MAX_POUR_PER_SECOND = 0.4
+export const POUR_RAMP_DEG = 25
+export const FOAM_SETTLE_PER_SECOND = 0.025
+export const SHAKE_THRESHOLD_G = 0.35
+export const SHAKE_FOAM_PER_G_SECOND = 0.3
+export const GRAVITY_SMOOTHING_ALPHA = 0.3
+// Below this share of gravity in the screen plane the phone is close to flat.
+export const MIN_IN_PLANE_GRAVITY = 0.3
+
+const MAX_STEP_SECONDS = 0.1
+const RAD_TO_DEG = 180 / Math.PI
+
+const clamp = (value: number, min: number, max: number): number =>
+    Math.min(max, Math.max(min, value))
+
+export const createFullBeer = (): BeerState => ({
+    fill: FULL_FILL,
+    foam: FRESH_FOAM,
+    isPouring: false,
+})
+
+export const isBeerEmpty = (state: BeerState): boolean => state.fill <= 0
+
+// Low-pass the raw vector rather than the angle so the filter never has to
+// deal with the ±180° wrap when the glass is upside down.
+export const smoothGravity = (
+    previous: GravitySample | null,
+    next: GravitySample,
+    alpha = GRAVITY_SMOOTHING_ALPHA,
+): GravitySample =>
+    previous
+        ? {
+              x: previous.x + (next.x - previous.x) * alpha,
+              y: previous.y + (next.y - previous.y) * alpha,
+              z: previous.z + (next.z - previous.z) * alpha,
+          }
+        : next
+
+// 0 when upright, positive when turned clockwise (right edge lower), ±180 when
+// upside down.
+export const pourAngleFromGravity = ({ x, y, z }: GravitySample): number | null => {
+    const magnitude = Math.hypot(x, y, z)
+    const inPlane = Math.hypot(x, y)
+    if (
+        magnitude === 0 ||
+        !Number.isFinite(magnitude) ||
+        inPlane / magnitude < MIN_IN_PLANE_GRAVITY
+    ) {
+        return null
+    }
+
+    return Math.atan2(x, -y) * RAD_TO_DEG
+}
+
+export const shakeFromSample = ({ x, y, z }: GravitySample): number => {
+    const magnitude = Math.hypot(x, y, z)
+    return Number.isFinite(magnitude) ? Math.abs(magnitude - 1) : 0
+}
+
+// For a rectangular glass of height/width `aspect`, a level surface turned by
+// θ about the glass centre rises tan(θ)/2 widths at the high edge, so beer
+// reaches the rim once tan(θ) > 2 · aspect · (1 − fill).
+export const spillAngleDeg = (fill: number, aspect: number): number =>
+    Math.atan(2 * Math.max(aspect, 0) * (1 - clamp(fill, 0, 1))) * RAD_TO_DEG
+
+export const pourRate = (fill: number, aspect: number, pourAngleDeg: number | null): number => {
+    if (pourAngleDeg === null || fill <= 0) {
+        return 0
+    }
+
+    const excessDeg = Math.abs(pourAngleDeg) - spillAngleDeg(fill, aspect)
+    return clamp(excessDeg / POUR_RAMP_DEG, 0, 1) * MAX_POUR_PER_SECOND
+}
+
+export const stepBeer = (
+    state: BeerState,
+    input: BeerInput,
+    elapsedSeconds: number,
+    aspect: number,
+): BeerState => {
+    if (isBeerEmpty(state)) {
+        return { fill: 0, foam: 0, isPouring: false }
+    }
+
+    const dt = clamp(elapsedSeconds, 0, MAX_STEP_SECONDS)
+    const rate = pourRate(state.fill, aspect, input.pourAngleDeg)
+    const fill = clamp(state.fill - rate * dt, 0, 1)
+    if (fill === 0) {
+        return { fill: 0, foam: 0, isPouring: false }
+    }
+
+    const shakeExcess = Math.max(0, input.shakeG - SHAKE_THRESHOLD_G)
+    // The head can never be thicker than the room left above the beer.
+    const foam = clamp(
+        state.foam + (shakeExcess * SHAKE_FOAM_PER_G_SECOND - FOAM_SETTLE_PER_SECOND) * dt,
+        0,
+        Math.min(MAX_FOAM, 1 - fill),
+    )
+
+    return { fill, foam, isPouring: rate > 0 }
+}
